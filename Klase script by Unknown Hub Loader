local missing = {}
if type(loadstring) ~= "function" then
	missing[#missing + 1] = "loadstring"
end
if type(getgenv) ~= "function" then
	missing[#missing + 1] = "getgenv"
end
if not pcall(function()
	return game.HttpGet
end) then
	missing[#missing + 1] = "HttpGet"
end
if #missing > 0 then
	return fail("your executor is missing: " .. table.concat(missing, ", "))
end

-- ============================================================================
-- SECTION 5: Splash screen
-- ============================================================================

local function makeSplash(name)
	-- Kill any previous splash instance
	pcall(function()
		local old = getgenv().__ChronixSplash
		if type(old) == "table" and type(old.kill) == "function" then
			old:kill()
		end
		getgenv().__ChronixSplash = nil
	end)

	-- Clean up any orphaned splash GUIs
	pcall(function()
		local roots = {}
		if type(gethui) == "function" then
			local h = gethui()
			if h then
				roots[#roots + 1] = h
			end
		end
		local okc, cg = pcall(function()
			return game:GetService("CoreGui")
		end)
		if okc and cg then
			roots[#roots + 1] = cg
		end
		local lp = game:GetService("Players").LocalPlayer
		local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
		if pg then
			roots[#roots + 1] = pg
		end

		for _, r in ipairs(roots) do
			for _, g in ipairs(r:GetChildren()) do
				if g:IsA("ScreenGui") and g.Name == "ChronixSplash" then
					pcall(function()
						g:Destroy()
					end)
				end
			end
		end
	end)

	-- Splash state
	local S = {
		target  = 0,   -- target progress [0..1]
		shown   = 0,   -- displayed progress (lerped)
		ceil    = 0,   -- upper bound / clamp
		rate    = 0.35,
		dead    = false,
		t0      = os.clock(),
		minTime = 0.6,
	}

	local accent = Color3.fromRGB(120, 110, 255)

	-- Determine mobile/small layout
	local small = false
	pcall(function()
		local cam = workspace.CurrentCamera
		small = UserInputService.TouchEnabled
			or (cam ~= nil and cam.ViewportSize.X < 700)
	end)

	local cardW = small and 250 or 320
	local cardH = small and 104 or 124

	-- Root GUI
	local sg = Instance.new("ScreenGui")
	sg.Name = "ChronixSplash"
	sg.ResetOnSpawn = false
	sg.IgnoreGuiInset = true
	sg.DisplayOrder = 1000
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- Dim background
	local dim = Instance.new("Frame")
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Parent = sg

	-- Card
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.fromScale(0.5, 0.5)
	card.Size = UDim2.fromOffset(cardW, cardH)
	card.BackgroundColor3 = Color3.fromRGB(14, 14, 19)
	card.BackgroundTransparency = 0.05
	card.BorderSizePixel = 0
	card.Parent = dim

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 10)
	cardCorner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = accent
	stroke.Thickness = 1
	stroke.Transparency = 0.3
	stroke.Parent = card

	-- Helper for creating children of the card
	local function mk(class, props)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		o.Parent = card
		return o
	end

	mk("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, small and 12 or 16),
		Size = UDim2.new(1, -32, 0, 14),
		Font = Enum.Font.GothamBold,
		Text = "CHRONIX HUB",
		TextColor3 = accent,
		TextSize = small and 11 or 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	local title = mk("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 0, small and 28 or 34),
		Size = UDim2.new(1, -32, 0, 22),
		Font = Enum.Font.GothamBold,
		Text = tostring(name or "loading"),
		TextColor3 = Color3.fromRGB(240, 242, 252),
		TextSize = small and 15 or 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local step = mk("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 16, 1, small and -36 or -42),
		Size = UDim2.new(1, -70, 0, 14),
		Font = Enum.Font.Gotham,
		Text = "connecting",
		TextColor3 = Color3.fromRGB(150, 152, 168),
		TextSize = small and 10 or 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local pct = mk("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 1, small and -36 or -42),
		Size = UDim2.new(0, 40, 0, 14),
		Font = Enum.Font.GothamBold,
		Text = "0%",
		TextColor3 = Color3.fromRGB(150, 152, 168),
		TextSize = small and 10 or 11,
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	-- Progress bar
	local track = mk("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 16, 1, small and -14 or -18),
		Size = UDim2.new(1, -32, 0, 5),
		BackgroundColor3 = Color3.fromRGB(38, 38, 48),
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
	})
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	-- Parent the GUI to the best available container
	if type(gethui) == "function" then
		pcall(function()
			sg.Parent = gethui()
		end)
	end
	if not sg.Parent and syn and type(syn.protect_gui) == "function" then
		pcall(function()
			syn.protect_gui(sg)
			sg.Parent = game:GetService("CoreGui")
		end)
	end
	if not sg.Parent then
		pcall(function()
			sg.Parent = game:GetService("CoreGui")
		end)
	end
	if not sg.Parent then
		pcall(function()
			local p = game:GetService("Players").LocalPlayer
			sg.Parent = p and p:FindFirstChildOfClass("PlayerGui")
		end)
	end
	S.Gui = sg

	-- Progress animation loop
	task.spawn(function()
		while not S.dead do
			local dt = RunService.Heartbeat:Wait()
			if S.ceil > S.target then
				local k = 1 - math.exp(-(S.rate or 0.35) * dt)
				S.target = S.target + (S.ceil - S.target) * k
			end
			S.shown = S.shown + (S.target - S.shown) * math.min(1, 9 * dt)
			if math.abs(S.target - S.shown) < 0.0015 then
				S.shown = S.target
			end
			fill.Size = UDim2.new(math.clamp(S.shown, 0, 1), 0, 1, 0)
			pct.Text = tostring(math.floor(S.shown * 100 + 0.5)) .. "%"
		end
	end)

	-- Public methods
	function S:say(t)
		pcall(function()
			step.Text = tostring(t)
		end)
	end

	function S:name(t)
		pcall(function()
			title.Text = tostring(t)
		end)
	end

	function S:pct(v)
		S.target = math.clamp(tonumber(v) or 0, 0, 1)
		if S.ceil < S.target then
			S.ceil = S.target
		end
	end

	function S:to(c, secs)
		S.ceil = math.clamp(tonumber(c) or 0, 0, 1)
		S.rate = 1 / math.max(tonumber(secs) or 3, 0.2)
	end

	function S:kill()
		if S.dead then
			return
		end
		S.dead = true
		S.shown = 1
		pcall(function()
			if getgenv().__ChronixSplash == S then
				getgenv().__ChronixSplash = nil
			end
		end)
		pcall(function()
			sg:Destroy()
		end)
	end

	function S:fail(t)
		if S.dead then
			return
		end
		S:say(t or "failed")
		pcall(function()
			fill.BackgroundColor3 = Color3.fromRGB(230, 80, 80)
			stroke.Color = Color3.fromRGB(230, 80, 80)
		end)
		task.delay(6, function()
			S:kill()
		end)
	end

	function S:done()
		if S.dead then
			return
		end
		S.ceil = 1
		S.rate = 6
		S:pct(1)
		S:say("ready")

		local left = S.minTime - (os.clock() - S.t0)
		if left > 0 then
			task.wait(left)
		end

		local spin = os.clock()
		while S.shown < 0.999 and os.clock() - spin < 1.5 do
			RunService.Heartbeat:Wait()
		end
		task.wait(0.15)

		-- Fade out
		for i = 1, 16 do
			local a = 1 - i / 16
			card.BackgroundTransparency = 0.05 + 0.95 * (1 - a)
			stroke.Transparency = 0.3 + 0.7 * (1 - a)
			for _, c in ipairs(card:GetChildren()) do
				if c:IsA("TextLabel") then
					c.TextTransparency = 1 - a
				end
				if c:IsA("Frame") then
					c.BackgroundTransparency = 1 - a
				end
			end
			RunService.Heartbeat:Wait()
		end
		S:kill()
	end

	return S
end

pcall(function()
	L = makeSplash("loading")
end)
pcall(function()
	getgenv().__ChronixSplash = L
end)
if L then
	L:say("checking your executor")
	L:pct(0.02)
	L:to(0.13, 2.5)
end

-- ============================================================================
-- SECTION 6: HTTP / encoding helpers
-- ============================================================================

-- URL-encode a string
local function enc(s)
	return (tostring(s):gsub("[^%w%-%.%_%~]", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

-- Cache buster
local bustN = 0
local function bust()
	bustN = bustN + 1
	return tostring(math.random(1, 999999999)) .. "x" .. tostring(bustN)
end

-- game:HttpGet with a fallback (some executors require the 2nd arg)
local function get(url)
	local ok, res = pcall(function()
		return game:HttpGet(url, true)
	end)
	if not ok or type(res) ~= "string" then
		ok, res = pcall(function()
			return game:HttpGet(url)
		end)
	end
	if ok and type(res) == "string" then
		return res
	end
	return nil, tostring(res)
end

-- Compile and run a chunk
local function run(source, label)
	local fn, compileErr = loadstring(source)
	if not fn then
		return fail(label .. " failed to compile: " .. tostring(compileErr))
	end
	local ranOk, runErr = pcall(fn)
	if not ranOk then
		return fail(label .. " errored: " .. tostring(runErr))
	end
	return true
end

-- ============================================================================
-- SECTION 7: Public build fallback
-- ============================================================================

local function loadPublic(why)
	if why then
		notify(why .. " - loading the public build")
		if L then
			L:say(tostring(why) .. " - public build")
		end
	end
	if L then
		L:pct(0.55)
	end
	if PUBLIC == "" then
		return fail(why or "no public build is configured")
	end
	local src, getErr = get(PUBLIC .. (PUBLIC:find("?", 1, true) and "&" or "?") .. "z=" .. bust())
	if not src or #src == 0 then
		return fail("cannot reach the public build: " .. tostring(getErr))
	end
	return run(src, "public build")
end

