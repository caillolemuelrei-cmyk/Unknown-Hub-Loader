local GATE   = "https://chronix-gate.net"  -- Gate server base URL
local KEY    = ""                          -- Optional license key (empty = public)
local SLUG   = ""                          -- Game slug (auto-detected if empty)
local PUBLIC = ""                          -- Fallback public build URL (empty = none)
