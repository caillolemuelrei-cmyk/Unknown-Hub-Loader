local function SendRequest(url, body)
    local req = syn and syn.request or (http_request or (request or http))
    if req then
        pcall(function()
            req({
                Url = url,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body
            })
        end)
    end
end

